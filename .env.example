# Copy to .env and fill in what you use. Everything is optional -- a source
# with no credentials simply reports itself unconfigured on the panel.
#
#   chmod 600 .env
#
# .env is gitignored and excluded from deploys. Nothing in here should ever
# reach config/settings.yaml, which is committed.

# --- calendars --------------------------------------------------------------
# Google Calendar -> Settings -> <your calendar> -> "Secret address in iCal
# format". Treat each like a password: anyone holding one can read that
# calendar, forever, without signing in.
GLANCE_ICS_AGENDA=
GLANCE_ICS_REMINDERS=
GLANCE_ICS_EVENTS=

# --- weather ----------------------------------------------------------------
# Open-Meteo needs no key or account, just coordinates. Right-click your house
# in Google Maps to get them.
GLANCE_LAT=
GLANCE_LON=

# --- home assistant ---------------------------------------------------------
# Your name at the bottom of the sidebar -> Security -> Long-lived access
# tokens. Shown once.
GLANCE_HA_URL=
GLANCE_HA_TOKEN=

# --- instagram --------------------------------------------------------------
# Needs a Meta app with instagram_basic; see the notes in settings.yaml.
GLANCE_IG_USER_ID=
GLANCE_IG_TOKEN=

# --- server -----------------------------------------------------------------
# Set ONLY if the server is reachable from the internet. With it set, every
# image and page needs ?k=<token>, and a wrong one answers 404 rather than 403.
#   openssl rand -hex 16
GLANCE_TOKEN=

# Point at a different settings.yaml.
# GLANCE_CONFIG=
