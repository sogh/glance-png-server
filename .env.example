# Google Calendar -> Settings -> <your calendar> -> Secret address in iCal format.
# Treat this like a password: anyone with it can read the whole calendar.
GLANCE_ICS_URL=https://calendar.google.com/calendar/ical/xxxxx/private-xxxxx/basic.ics

# Optional: point at a different config file.
# GLANCE_CONFIG=config/settings.yaml

# Optional. Set this only if the server is reachable from the internet.
# Generate with: openssl rand -hex 16
# GLANCE_TOKEN=
